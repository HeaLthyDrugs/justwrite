{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "justwrite",
  "compatibility_date": "2026-06-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    { "pattern": "justwrite.sbs", "custom_domain": true },
    { "pattern": "www.justwrite.sbs", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "justwrite"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "JUSTWRITE_SYNC_KV",
      "id": "c552d7998095418b95480667ce59ea6b"
    },
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "56e80102a7914ae4a00e5de9100dd4d1"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
